@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Write feedback independently of attendance
start
:<b>Coach:</b> Load feedback and submit\nrating or note with expectedVersion;
:<b>System:</b> Validate operator, member,\nsession time and payload;
if (Feedback request valid?) then (Yes)
  if (expectedVersion matches?) then (Yes)
    :<b>System:</b> Save feedback, author,\nversion and audit;
    :<b>System:</b> Leave Attendance unchanged;
  else (No)
    :<b>System:</b> Return HTTP 409 conflict;
    :<b>Coach:</b> Reload, review changes and\nsubmit a new request;
  endif
else (No)
  :<b>System:</b> Reject invalid feedback\nrequest;
endif
stop
@enduml
