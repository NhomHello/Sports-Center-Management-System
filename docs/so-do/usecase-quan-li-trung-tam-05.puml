  usecase "UC-PAY-06\nCollect cash at reception" as U3
  usecase "UC-PAY-07\nDownload or print receipt" as U4
  usecase "UC-PAY-08\nView payment history" as U5
  usecase "UC-PAY-09\nTrack and complete refunds" as U6
  usecase "UC-PAY-10\nView invoice details" as U7
}
