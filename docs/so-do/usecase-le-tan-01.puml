@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Use Case - Receptionist - Part 1
left to right direction
actor "Receptionist" as Actor
rectangle "Sports Center Management System" {
  usecase "UC-UM-02\nView and update personal information" as U0
  usecase "UC-UM-05\nCreate member at reception" as U1
  usecase "UC-UM-06\nFind a member" as U2
  usecase "UC-UM-11\nSign in and sign out" as U3
  usecase "UC-UM-12\nReset password" as U4
  usecase "UC-UM-13\nChange password" as U5
  usecase "UC-UM-14\nView member details" as U6
  usecase "UC-UM-17\nRead personal notifications" as U7
}
Actor -- U0
Actor -- U1
Actor -- U2
Actor -- U3
Actor -- U4
Actor -- U5
Actor -- U6
Actor -- U7
@enduml
