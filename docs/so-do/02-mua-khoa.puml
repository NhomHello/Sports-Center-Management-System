@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Request and pay for a course
start
:<b>Member:</b> Choose course and confirm\nquoted tuition;
:<b>System:</b> Check member, schedule and\nregistration eligibility;
if (Eligibility checks pass?) then (Yes)
else (No)
  :<b>System:</b> Reject registration;
  stop
endif
if (Seat available?) then (Yes)
  :<b>System:</b> Snapshot price and sessions;\ncreate invoice and seat hold;
else (No)
  :<b>System:</b> Return waiting-list option\nwithout an invoice;
  stop
endif
:<b>Member:</b> Transfer the amount with the\ninvoice reference before deadline;
:<b>System:</b> Keep PENDING_PAYMENT until\npayment processing confirms it;
stop
@enduml
