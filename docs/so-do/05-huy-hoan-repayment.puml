@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Complete a pending refund
start
:<b>Member:</b> Provide HT lookup code to\nCenter Manager;
:<b>Center Manager:</b> Verify refund,\nrecipient and amount;
if (Refund still pending?) then (Yes)
  :<b>Center Manager:</b> Repay outside the\napplication;
  :<b>Center Manager:</b> Submit repayment\nreference;
  :<b>System:</b> Verify refund permission and\ncurrent state;
  :<b>System:</b> Record repayment once and\nset DONE;
  :<b>System:</b> Notify member of completed\nrepayment;
else (No)
  :<b>System:</b> Show existing status without\na second repayment;
endif
stop
@enduml
