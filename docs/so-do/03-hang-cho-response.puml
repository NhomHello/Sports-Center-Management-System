@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Respond to a waiting-list offer
start
if (Accept the offer?) then (Yes)
  :<b>System:</b> Recheck offer, registration\nwindow and eligibility;
  if (Offer and seat still valid?) then (Yes)
    :<b>System:</b> Create invoice and\nPENDING_PAYMENT hold;
    :<b>System:</b> Set waiting entry ACCEPTED;
    :<b>System:</b> Await valid payment before\nBOOKED;
  else (No)
    :<b>System:</b> Reject purchase and update\ndue waiting entries;
  endif
else (Decline or expire)
  :<b>System:</b> Cancel or expire offer\naccording to the trigger;
  :<b>System:</b> Review the next eligible\nwaiting member;
endif
stop
@enduml
