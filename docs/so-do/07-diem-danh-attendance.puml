@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Record session attendance
start
:<b>Coach:</b> Select session and submit\nattendance entries;
:<b>System:</b> Check scope, session time\nand all members under lock;
if (Attendance write allowed?) then (Yes)
  :<b>System:</b> Preserve EXCUSED when ABSENT\nis submitted;
  :<b>System:</b> Save Attendance and audit\natomically;
  :<b>System:</b> Refresh absence-based\nenrollment block;
else (No)
  if (Only issue is a closed edit\nwindow?) then (Yes)
    :<b>Center Manager:</b> Open a temporary\nedit window with a reason;
    :<b>Coach:</b> Resubmit through the same\nattendance validation;
  else (No)
    :<b>System:</b> Reject request without\npartial attendance changes;
  endif
endif
stop
@enduml
