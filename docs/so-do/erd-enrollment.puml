@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Course enrollment
left to right direction
hide circle
hide methods
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 80
skinparam ArrowFontSize 13
entity "User\n(users)" as T_User {
  * id : Int <<PK>>
  * roleId : Int <<FK>>
  email : String? <<UQ>>
  * fullName : String
  * status : UserStatus
}
entity "GymClass\n(gym_classes)" as T_GymClass {
  * id : Int <<PK>>
  * subjectId : Int <<FK>>
  * roomId : Int <<FK>>
  * coachId : Int <<FK>>
  * name : String
  * capacity : Int
  * registrationStartAt : DateTime
  * registrationEndAt : DateTime
  * status : ClassStatus
  * price : Int
}
entity "Invoice\n(invoices)" as T_Invoice {
  * id : Int <<PK>>
  * userId : Int <<FK>>
  planId : Int? <<FK>>
  membershipId : Int? <<FK>>
  classId : Int? <<FK>>
  * code : String <<UQ>>
  planName : String?
  * amount : Int
  * status : InvoiceStatus
  paidAt : DateTime?
  * kind : InvoiceKind
  sessionCount : Int?
  totalSessions : Int?
}
entity "ClassEnrollment\n(class_enrollments)" as T_ClassEnrollment {
  * id : Int <<PK>>
  * classId : Int <<FK>>
  * memberId : Int <<FK>>
  * enrolledBy : Int <<FK>>
  cancelledBy : Int? <<FK>>
  invoiceId : Int? <<FK>>
  * status : EnrollmentStatus
  holdExpiresAt : DateTime?
}
note bottom of T_ClassEnrollment : Unique together: classId, memberId
T_GymClass ||..o{ T_ClassEnrollment
T_User ||..o{ T_ClassEnrollment : member
T_User ||..o{ T_ClassEnrollment : enrolledByUser
T_User |o..o{ T_ClassEnrollment : cancelledByUser
T_Invoice |o..o{ T_ClassEnrollment
legend bottom
  PK = primary key; FK = foreign key; UQ = unique key
  * = mandatory attribute; ? = nullable type
  Solid = identifying relationship; dashed = non-identifying relationship
  Focus: ClassEnrollment. Other references are in the full ERD.
endlegend
@enduml
