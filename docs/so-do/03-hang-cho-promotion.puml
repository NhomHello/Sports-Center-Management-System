@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Promote the next eligible waiting member
start
:<b>System:</b> Handle worker or seat-\nrelease event;
:<b>System:</b> Expire overdue offers;
if (Course OPEN and registration\nactive?) then (Yes)
else (No)
  :<b>System:</b> Cancel active waiting\nentries and offers;
  stop
endif
if (Seat available?) then (Yes)
  :<b>System:</b> Scan candidates in FIFO\norder and recheck eligibility;
else (No)
  :<b>System:</b> Keep entries WAITING for a\nlater event;
  stop
endif
if (Eligible candidate found?) then (Yes)
  :<b>System:</b> Set OFFERED with expiry no\nlater than registration end;
  :<b>System:</b> Reserve capacity and notify\nselected member;
else (No)
  :<b>System:</b> Leave seat available;
endif
stop
@enduml
