@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Resolve a reviewed reconciliation case
start
:<b>Center Manager:</b> Select case after\nevidence review and member contact;
if (Refund required?) then (Yes)
  :<b>System:</b> Create PENDING refund for\nthe eligible amount;
  :<b>Center Manager:</b> Continue with refund\nrepayment workflow;
  stop
else (No)
  if (Allocate or accept transfer?) then (Yes)
    :<b>System:</b> Recheck amount, invoice,\ndeadline, seat and schedule;
    if (Settlement valid?) then (Yes)
      :<b>System:</b> Apply shared payment and\nclosure rules;
      stop
    else (No)
      :<b>System:</b> Keep unresolved money for\nanother valid decision;
      stop
    endif
  else (Investigate)
    :<b>Center Manager:</b> Record reason and\npreserve unresolved money;
    stop
  endif
endif
@enduml
