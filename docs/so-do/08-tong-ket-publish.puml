@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Publish an assigned course summary
start
:<b>Coach:</b> Load assigned draft and\nserver-calculated attendance;
:<b>Coach:</b> Enter results, progress and\nrequired comments;
:<b>Coach:</b> Confirm missing attendance if\nnecessary;
:<b>System:</b> Validate authorship, draft\nstate and required data;
if (Publication requirements\nsatisfied?) then (Yes)
  :<b>System:</b> Publish snapshot and\nincrement revision atomically;
  :<b>System:</b> Queue member notifications;
  :<b>Member:</b> Read own published results\nor download result PDF;
else (No)
  :<b>System:</b> Keep DRAFT and return\nrequired corrections;
endif
stop
@enduml
