@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Course enrollment lifecycle
hide empty description
left to right direction
skinparam nodesep 55
skinparam ranksep 65
state PENDING_PAYMENT
state BOOKED
state CANCELLED
state CreationChoice <<choice>>
[*] --> CreationChoice : create
CreationChoice --> PENDING_PAYMENT : [course price > 0]
CreationChoice --> BOOKED : [course price = 0]
PENDING_PAYMENT --> BOOKED : paymentConfirmed [valid]
PENDING_PAYMENT --> CANCELLED : holdExpiredOrReleased
BOOKED --> CANCELLED : cancelOrChange
CANCELLED --> PENDING_PAYMENT : repurchase [eligible]
CANCELLED --> BOOKED : enroll [zero price, eligible]
@enduml
