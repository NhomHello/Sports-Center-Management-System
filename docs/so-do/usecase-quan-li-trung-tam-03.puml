@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Use Case - Center Manager - Part 3
left to right direction
actor "Center Manager" as Actor
rectangle "Sports Center Management System" {
  usecase "UC-CB-01\nManage subjects" as U0
  usecase "UC-CB-02\nCreate course and sessions" as U1
  usecase "UC-CB-03\nUpdate course, schedule or coach" as U2
  usecase "UC-CB-04\nCancel course as the center" as U3
  usecase "UC-CB-09\nEnroll on behalf of a member" as U4
  usecase "UC-CB-10\nCancel enrollment on behalf of a\nmember" as U5
  usecase "UC-CB-12\nView course roster" as U6
  usecase "UC-CB-13\nReceive cancellation refund requests" as U7
}
Actor -- U0
Actor -- U1
Actor -- U2
Actor -- U3
Actor -- U4
Actor -- U5
Actor -- U6
Actor -- U7
@enduml
