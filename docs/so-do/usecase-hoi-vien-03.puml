@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Use Case - Member - Part 3
left to right direction
actor "Member" as Actor
rectangle "Sports Center Management System" {
  usecase "UC-CB-21\nView course cancellation history" as U0
  usecase "UC-CB-22\nRelease an unpaid seat hold" as U1
  usecase "UC-PAY-01\nPay for a course online" as U2
  usecase "UC-PAY-03\nTrack payment status" as U3
  usecase "UC-PAY-07\nDownload or print receipt" as U4
  usecase "UC-PAY-08\nView payment history" as U5
  usecase "UC-PAY-09\nTrack my refund requests" as U6
  usecase "UC-PAY-10\nView invoice details" as U7
}
Actor -- U0
Actor -- U1
Actor -- U2
Actor -- U3
Actor -- U4
Actor -- U5
Actor -- U6
Actor -- U7
@enduml
