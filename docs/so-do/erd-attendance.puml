@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Session attendance and feedback
left to right direction
hide circle
hide methods
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 80
skinparam ArrowFontSize 13
entity "User\n(users)" as T_User {
  * id : Int <<PK>>
  * roleId : Int <<FK>>
  email : String? <<UQ>>
  * fullName : String
  * status : UserStatus
}
entity "GymClass\n(gym_classes)" as T_GymClass {
  * id : Int <<PK>>
  * subjectId : Int <<FK>>
  * roomId : Int <<FK>>
  * coachId : Int <<FK>>
  * name : String
  * capacity : Int
  * registrationStartAt : DateTime
  * registrationEndAt : DateTime
  * status : ClassStatus
  * price : Int
}
entity "ClassSession\n(class_sessions)" as T_ClassSession {
  * id : Int <<PK>>
  * classId : Int <<FK>>
  roomId : Int? <<FK>>
  coachId : Int? <<FK>>
  * startAt : DateTime
  * endAt : DateTime
  * status : SessionStatus
}
entity "ClassEnrollment\n(class_enrollments)" as T_ClassEnrollment {
  * id : Int <<PK>>
  * classId : Int <<FK>>
  * memberId : Int <<FK>>
  * enrolledBy : Int <<FK>>
  cancelledBy : Int? <<FK>>
  invoiceId : Int? <<FK>>
  * status : EnrollmentStatus
  holdExpiresAt : DateTime?
}
note bottom of T_ClassEnrollment : Unique together: classId, memberId
entity "Attendance\n(attendance)" as T_Attendance {
  * id : Int <<PK>>
  * sessionId : Int <<FK>>
  * memberId : Int <<FK>>
  * status : AttendanceStatus
}
note bottom of T_Attendance : Unique together: sessionId, memberId
entity "SessionFeedback\n(session_feedback)" as T_SessionFeedback {
  * id : Int <<PK>>
  * sessionId : Int <<FK>>
  * memberId : Int <<FK>>
  * authorId : Int <<FK>>
  * version : Int
  rating : Int?
}
note bottom of T_SessionFeedback : Unique together: sessionId, memberId
entity "CheckIn\n(check_ins)" as T_CheckIn {
  * id : Int <<PK>>
  * memberId : Int <<FK>>
  * actorId : Int <<FK>>
  sessionId : Int? <<FK>>
  * kind : CheckInKind
  * code : String
}
note bottom of T_CheckIn : Unique together: memberId, sessionId
T_User ||..o{ T_CheckIn : actor
T_ClassSession |o..o{ T_CheckIn
T_User ||..o{ T_CheckIn : member
T_ClassSession ||..o{ T_Attendance
T_User ||..o{ T_Attendance
T_ClassSession ||..o{ T_SessionFeedback
T_User ||..o{ T_SessionFeedback : member
T_User ||..o{ T_SessionFeedback : author
legend bottom
  PK = primary key; FK = foreign key; UQ = unique key
  * = mandatory attribute; ? = nullable type
  Solid = identifying relationship; dashed = non-identifying relationship
  Focus: Attendance, CheckIn, SessionFeedback. Other references are in the full ERD.
endlegend
@enduml
