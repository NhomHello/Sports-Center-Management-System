@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Join a full course waiting list
start
:<b>Member:</b> Request waiting-list entry;
:<b>System:</b> Promote due entries and\ncheck current member state;
if (Already WAITING or OFFERED?) then (Yes)
  :<b>System:</b> Return existing entry\nwithout duplicating it;
  stop
endif
if (Course full and other\neligibility checks pass?) then (Yes)
  :<b>System:</b> Create WAITING entry ordered\nby joinedAt and ID;
  :<b>System:</b> Return waiting confirmation\nwithout an invoice;
else (No)
  :<b>System:</b> Reject request or direct\nmember to normal purchase;
endif
stop
@enduml
