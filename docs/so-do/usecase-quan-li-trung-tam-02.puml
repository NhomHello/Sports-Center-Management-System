@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Use Case - Center Manager - Part 2
left to right direction
actor "Center Manager" as Actor
rectangle "Sports Center Management System" {
  usecase "UC-UM-15\nView audit log" as U0
  usecase "UC-UM-16\nConfigure system settings" as U1
  usecase "UC-UM-17\nRead personal notifications" as U2
  usecase "UC-UM-18\nManage roles and permissions" as U3
  usecase "UC-UM-19\nUpdate member / verify email at\nreception" as U4
  usecase "UC-UM-23\nBrowse coaches and public profiles" as U5
  usecase "UC-UM-24\nUpdate training profile" as U6
  usecase "UC-UM-26\nView permission-based dashboard" as U7
}
Actor -- U0
Actor -- U1
Actor -- U2
Actor -- U3
Actor -- U4
Actor -- U5
Actor -- U6
Actor -- U7
@enduml
