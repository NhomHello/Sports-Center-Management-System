@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Course definition and resources
left to right direction
hide circle
hide methods
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 80
skinparam ArrowFontSize 13
entity "User\n(users)" as T_User {
  * id : Int <<PK>>
  * roleId : Int <<FK>>
  email : String? <<UQ>>
  * fullName : String
  * status : UserStatus
}
entity "Subject\n(subjects)" as T_Subject {
  * id : Int <<PK>>
  * name : String <<UQ>>
}
entity "Room\n(rooms)" as T_Room {
  * id : Int <<PK>>
  roomTypeId : Int? <<FK>>
  * name : String <<UQ>>
  * capacity : Int
}
entity "GymClass\n(gym_classes)" as T_GymClass {
  * id : Int <<PK>>
  * subjectId : Int <<FK>>
  * roomId : Int <<FK>>
  * coachId : Int <<FK>>
  * name : String
  * capacity : Int
  * registrationStartAt : DateTime
  * registrationEndAt : DateTime
  * status : ClassStatus
  * price : Int
}
T_Subject ||..o{ T_GymClass
T_Room ||..o{ T_GymClass
T_User ||..o{ T_GymClass
legend bottom
  PK = primary key; FK = foreign key; UQ = unique key
  * = mandatory attribute; ? = nullable type
  Solid = identifying relationship; dashed = non-identifying relationship
  Focus: GymClass. Other references are in the full ERD.
endlegend
@enduml
