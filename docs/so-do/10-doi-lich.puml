@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Reschedule a session or a course timetable
start
:<b>Center Manager:</b> Select a new time\nand request preview;
:<b>System:</b> Compute the resulting\nschedule, preserving individual\nsession overrides;
if (Every affected old and new start\nmeets the notice period?) then (Yes)
  :<b>System:</b> Check operating frames,\ncoach and room availability;
  :<b>System:</b> Check booked members and\npending payment seats against other\ncourses;
  if (Any resource or member conflict?) then (Yes)
    :<b>System:</b> Reject the request and\nretain the existing schedule;
  else (No)
    :<b>Center Manager:</b> Confirm the preview;
    :<b>System:</b> Lock the schedule and repeat\nall policy checks;
    if (Still valid?) then (Yes)
      :<b>System:</b> Save sessions, notification\noutbox and audit atomically;
    else (No)
      :<b>System:</b> Roll back and request a new\npreview;
    endif
  endif
else (No)
  :<b>System:</b> Reject with the configured\nnotice period (at least 48 hours);
endif
stop
@enduml
