@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Reopen a published course summary
start
:<b>Center Manager:</b> Select published\nsummary and enter reason;
if (Reopen permission and reason\nvalid?) then (Yes)
  :<b>System:</b> Set summary DRAFT and record\naudit;
else (No)
  :<b>System:</b> Reject reopen request;
  stop
endif
:<b>Coach:</b> Revise the assigned draft;
:<b>Coach:</b> Submit a new publication\nrequest;
if (Publication requirements\nsatisfied?) then (Yes)
  :<b>System:</b> Publish a new snapshot and\nrevision;
  :<b>System:</b> Notify members of updated\nresults;
else (No)
  :<b>System:</b> Keep DRAFT and return\nrequired corrections;
endif
stop
@enduml
