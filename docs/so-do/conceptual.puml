@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title Conceptual model - Sports Center Management System
left to right direction
hide circle
skinparam linetype ortho
entity User
entity Role
entity Permission
entity RolePermission
entity Course
entity Session
entity Enrollment
entity Invoice
entity Payment
entity Refund
entity Attendance
entity SessionFeedback
entity CourseSummary
entity MemberResult
entity CourseRating
Role ||--o{ User
Role ||--o{ RolePermission
Permission ||--o{ RolePermission
User ||--o{ Enrollment
Course ||--o{ Enrollment
Course ||--o{ Session
Enrollment |o--o| Invoice : current purchase
Invoice ||--o{ Payment
Invoice |o--o{ Refund
Session ||--o{ Attendance
Session ||--o{ SessionFeedback
Course ||--o| CourseSummary
CourseSummary ||--o{ MemberResult
Course ||--o{ CourseRating
User ||--o{ CourseRating
legend bottom
  Conceptual entities summarize the current course-based business.
  Refer to the physical ERD for nullable links, foreign keys and retained legacy models.
endlegend
@enduml
