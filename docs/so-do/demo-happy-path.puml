@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam ArrowColor #25465E
skinparam ArrowThickness 1.3
skinparam defaultTextAlignment center
skinparam activityBackgroundColor #F0F5F9
skinparam activityBorderColor #25465E
skinparam stateBackgroundColor #F0F5F9
skinparam stateBorderColor #25465E
skinparam classBackgroundColor #F0F5F9
skinparam classBorderColor #25465E
skinparam usecaseBackgroundColor #F0F5F9
skinparam usecaseBorderColor #25465E
skinparam conditionStyle diamond
!pragma useVerticalIf on

title One continuous demo - four happy-path workflows
start
partition "WF1 - Course and member preparation" {
  :Course A ready;
  :Member M profile and shared training\ngoals ready;
}
partition "WF2 - Purchase and successful payment" {
  :Member M creates invoice I and\ndisplays code / QR;
  :Invoice I is PAID; M is BOOKED in A;
  :Receptionist opens the same invoice\nand receipt;
  :Member transfers the whole A\nenrollment to equivalent course A2;
  :A enrollment is CANCELLED; A2\nenrollment is BOOKED;
}
partition "WF3 - Learning progress" {
  :Assigned coach records PRESENT and\nfeedback in B within the authorized\nattendance window;
  :Member M reads the saved attendance\nand feedback;
}
partition "WF4 - Results, rating and management report" {
  :Coach publishes completed-course C\nsummary;
  :Member M reads results and submits\ncourse rating;
  :Center Manager report for A / M\nincludes invoice I;
}
stop
legend bottom
  One member M throughout the entire demonstration.
  A = next course; B = ongoing learning course; C = completed course.
  B and C history are prepared before the demo.
  WF2 shows code / QR, then success; exact payment is simulated off-screen.
endlegend
@enduml
