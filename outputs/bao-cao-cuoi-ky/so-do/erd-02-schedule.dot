digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Lớp và lịch học"; labelloc=t;
User [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">users</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : UserStatus</TD></TR><TR><TD ALIGN="LEFT">roleId : Int [FK]</TD></TR></TABLE>>];
Subject [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Subject</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">subjects</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR></TABLE>>];
Room [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Room</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">rooms</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR><TR><TD ALIGN="LEFT">roomTypeId : Int? [FK]</TD></TR></TABLE>>];
RoomType [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>RoomType</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">room_types</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR></TABLE>>];
RoomTypeSubject [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>RoomTypeSubject</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">room_type_subjects</FONT></TD></TR><TR><TD ALIGN="LEFT">roomTypeId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">subjectId : Int [FK]</TD></TR></TABLE>>];
CoachSubject [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>CoachSubject</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">coach_subjects</FONT></TD></TR><TR><TD ALIGN="LEFT">coachId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">subjectId : Int [FK]</TD></TR></TABLE>>];
OperatingFrame [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>OperatingFrame</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">operating_frames</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR></TABLE>>];
GymClass [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>GymClass</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">gym_classes</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR><TR><TD ALIGN="LEFT">subjectId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">roomId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">coachId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">status : ClassStatus</TD></TR></TABLE>>];
ClassSession [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ClassSession</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">class_sessions</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">classId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">roomId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">coachId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">status : SessionStatus</TD></TR></TABLE>>];
ClassEnrollment [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ClassEnrollment</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">class_enrollments</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">classId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">memberId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">status : EnrollmentStatus</TD></TR><TR><TD ALIGN="LEFT">enrolledBy : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">cancelledBy : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR></TABLE>>];
ClassWaitlist [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ClassWaitlist</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">class_waitlist</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">classId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">memberId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">status : WaitlistStatus</TD></TR></TABLE>>];
RoomMaintenance [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>RoomMaintenance</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">room_maintenance</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">roomId : Int [FK]</TD></TR></TABLE>>];
Attendance [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Attendance</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">attendance</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">sessionId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">memberId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">status : AttendanceStatus</TD></TR></TABLE>>];
CheckIn [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>CheckIn</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">check_ins</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">memberId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">actorId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">sessionId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">code : String</TD></TR></TABLE>>];
ClassEvent [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ClassEvent</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">class_events</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">classId : Int [FK]</TD></TR></TABLE>>];
ScheduleLock [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ScheduleLock</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">schedule_locks</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR></TABLE>>];
Room -> RoomType [label="roomTypeId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
RoomTypeSubject -> RoomType [label="roomTypeId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
RoomTypeSubject -> Subject [label="subjectId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CoachSubject -> User [label="coachId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CoachSubject -> Subject [label="subjectId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
GymClass -> Subject [label="subjectId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
GymClass -> Room [label="roomId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
GymClass -> User [label="coachId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassSession -> Room [label="roomId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassSession -> User [label="coachId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassSession -> GymClass [label="classId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassEnrollment -> GymClass [label="classId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassEnrollment -> User [label="memberId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassEnrollment -> User [label="enrolledBy", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassEnrollment -> User [label="cancelledBy", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassEvent -> GymClass [label="classId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CheckIn -> User [label="actorId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CheckIn -> ClassSession [label="sessionId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
CheckIn -> User [label="memberId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Attendance -> ClassSession [label="sessionId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Attendance -> User [label="memberId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassWaitlist -> GymClass [label="classId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
ClassWaitlist -> User [label="memberId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
RoomMaintenance -> Room [label="roomId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
