digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Giải quyết thiếu/thừa và tiền chưa gán"; labelloc=t;
subgraph cluster_0 { label="Ngân hàng / hội viên"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#f4f8fc";
a [label="Webhook / báo đã chuyển", shape=box];
}
subgraph cluster_1 { label="Hệ thống"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#eaf4f3";
b [label="Xác thực, chống trùng ID;\nđọc lại tiền dưới khóa", shape=box];
c [label="Đủ tiền và được chốt?", shape=diamond];
d [label="PAID, BOOKED; đóng\nphiếu thiếu đã được bù", shape=box];
f [label="Tiền được phân bổ hợp lệ\nhoặc tạo Refund PENDING", shape=box];
h [label="DONE / REFUNDED; đóng đúng\nphiếu, giữ khoản chưa giải quyết", shape=box];
}
subgraph cluster_2 { label="Nhân viên có quyền"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#fff8ec";
e [label="Kiểm tra chứng cứ, liên hệ;\nkhông bỏ qua khoản có chủ", shape=box];
g [label="Chuyển trả thật rồi nhập\ntham chiếu ngân hàng", shape=box];
}
a -> b [label=""];
b -> c [label=""];
c -> d [label="Có"];
c -> e [label="Không"];
e -> f [label=""];
f -> g [label="Cần hoàn"];
g -> h [label="Đã chuyển trả"];
}