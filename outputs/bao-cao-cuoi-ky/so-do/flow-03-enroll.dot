digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Danh sách chờ trong hạn đăng ký"; labelloc=t;
subgraph cluster_0 { label="Hội viên"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#f4f8fc";
a [label="Chọn khóa đủ điều kiện\nnhưng hết chỗ", shape=box];
f [label="Xác nhận tạo đơn trong hạn", shape=box];
}
subgraph cluster_1 { label="Hệ thống"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#eaf4f3";
b [label="Vào WAITING; giữ FIFO\njoinedAt rồi ID", shape=box];
d [label="Khóa OPEN, còn hạn\nvà có ứng viên hợp lệ?", shape=diamond];
e [label="OFFERED; gửi lời mời; hạn\nkhông vượt hạn đăng ký khóa", shape=box];
g [label="Giữ PENDING_PAYMENT;\nBOOKED sau thanh toán", shape=box];
h [label="Không mời / hết lời mời;\nxét người tiếp theo theo điều kiện", shape=box];
}
subgraph cluster_2 { label="Worker / nhân viên"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#fff8ec";
c [label="Một chỗ đã được nhả", shape=box];
}
a -> b [label=""];
b -> c [label=""];
c -> d [label=""];
d -> e [label="Có"];
d -> h [label="Không"];
e -> f [label=""];
f -> g [label="Trong hạn"];
e -> h [label="Quá hạn"];
}