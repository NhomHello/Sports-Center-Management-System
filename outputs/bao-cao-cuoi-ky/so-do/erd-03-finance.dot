digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Gói và tài chính"; labelloc=t;
User [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">users</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : UserStatus</TD></TR><TR><TD ALIGN="LEFT">roleId : Int [FK]</TD></TR></TABLE>>];
MembershipPlan [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>MembershipPlan</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">membership_plans</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">code : String</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR><TR><TD ALIGN="LEFT">status : MembershipPlanStatus</TD></TR></TABLE>>];
Membership [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Membership</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">memberships</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">planId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">status : MembershipStatus</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR></TABLE>>];
MembershipFreeze [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>MembershipFreeze</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">membership_freezes</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">membershipId : Int [FK]</TD></TR></TABLE>>];
PlanFrame [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>PlanFrame</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">plan_frames</FONT></TD></TR><TR><TD ALIGN="LEFT">planId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">frameId : Int [FK]</TD></TR></TABLE>>];
PlanRoomType [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>PlanRoomType</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">plan_room_types</FONT></TD></TR><TR><TD ALIGN="LEFT">planId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">roomTypeId : Int [FK]</TD></TR></TABLE>>];
Invoice [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Invoice</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">invoices</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">code : String</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">planId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">membershipId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">status : InvoiceStatus</TD></TR><TR><TD ALIGN="LEFT">classId : Int? [FK]</TD></TR></TABLE>>];
Payment [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Payment</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">payments</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int [FK]</TD></TR></TABLE>>];
PaymentWebhookLog [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>PaymentWebhookLog</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">payment_webhook_logs</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : WebhookLogStatus</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR></TABLE>>];
ReconciliationCase [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ReconciliationCase</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">reconciliation_cases</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : ReconciliationStatus</TD></TR><TR><TD ALIGN="LEFT">webhookLogId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR></TABLE>>];
ReconciliationContact [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>ReconciliationContact</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">reconciliation_contacts</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">caseId : Int [FK]</TD></TR></TABLE>>];
Refund [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Refund</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">refunds</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">caseId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">status : RefundStatus</TD></TR></TABLE>>];
CreditTransaction [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>CreditTransaction</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">credit_transactions</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">invoiceId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">changeId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">actorId : Int [FK]</TD></TR></TABLE>>];
PurchaseChange [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>PurchaseChange</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">purchase_changes</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : PurchaseChangeStatus</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">actorId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">fromInvoiceId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">fromMembershipId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">fromEnrollmentId : Int? [FK]</TD></TR><TR><TD ALIGN="LEFT">toPlanId : Int? [FK]</TD></TR></TABLE>>];
Membership -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Membership -> MembershipPlan [label="planId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Membership -> Invoice [label="invoiceId", headlabel="0..1", taillabel="0..1", labeldistance=2, fontsize=8];
Invoice -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Invoice -> MembershipPlan [label="planId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
Invoice -> Membership [label="membershipId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
Payment -> Invoice [label="invoiceId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PaymentWebhookLog -> Invoice [label="invoiceId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
ReconciliationCase -> PaymentWebhookLog [label="webhookLogId", headlabel="0..1", taillabel="0..1", labeldistance=2, fontsize=8];
ReconciliationCase -> Invoice [label="invoiceId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
ReconciliationContact -> ReconciliationCase [label="caseId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
Refund -> Invoice [label="invoiceId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
Refund -> ReconciliationCase [label="caseId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
MembershipFreeze -> Membership [label="membershipId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PlanFrame -> MembershipPlan [label="planId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PlanRoomType -> MembershipPlan [label="planId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CreditTransaction -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CreditTransaction -> User [label="actorId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
CreditTransaction -> Invoice [label="invoiceId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
CreditTransaction -> PurchaseChange [label="changeId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> User [label="actorId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> Invoice [label="fromInvoiceId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> Membership [label="fromMembershipId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> MembershipPlan [label="toPlanId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
PurchaseChange -> Refund [label="refundId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
}