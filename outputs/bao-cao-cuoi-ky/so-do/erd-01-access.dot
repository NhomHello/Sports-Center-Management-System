digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Tài khoản và quyền"; labelloc=t;
User [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">users</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">status : UserStatus</TD></TR><TR><TD ALIGN="LEFT">roleId : Int [FK]</TD></TR></TABLE>>];
Role [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Role</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">roles</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">code : String</TD></TR><TR><TD ALIGN="LEFT">name : String</TD></TR></TABLE>>];
Permission [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Permission</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">permissions</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">code : String</TD></TR></TABLE>>];
RolePermission [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>RolePermission</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">role_permissions</FONT></TD></TR><TR><TD ALIGN="LEFT">roleId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">permissionId : Int [FK]</TD></TR></TABLE>>];
EmailVerificationToken [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>EmailVerificationToken</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">email_verification_tokens</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR></TABLE>>];
LoginThrottle [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>LoginThrottle</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">login_throttles</FONT></TD></TR><TR><TD ALIGN="LEFT">key : String [PK]</TD></TR></TABLE>>];
SystemSetting [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>SystemSetting</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">system_settings</FONT></TD></TR><TR><TD ALIGN="LEFT">key : String [PK]</TD></TR></TABLE>>];
AuditLog [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>AuditLog</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">audit_logs</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">userId : Int? [FK]</TD></TR></TABLE>>];
Notification [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#163b58"><FONT COLOR="white"><B>Notification</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">notifications</FONT></TD></TR><TR><TD ALIGN="LEFT">id : Int [PK]</TD></TR><TR><TD ALIGN="LEFT">userId : Int [FK]</TD></TR><TR><TD ALIGN="LEFT">membershipId : Int? [FK]</TD></TR></TABLE>>];
User -> Role [label="roleId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
EmailVerificationToken -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
RolePermission -> Role [label="roleId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
RolePermission -> Permission [label="permissionId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
AuditLog -> User [label="userId", headlabel="0..1", taillabel="0..*", labeldistance=2, fontsize=8];
Notification -> User [label="userId", headlabel="1", taillabel="0..*", labeldistance=2, fontsize=8];
}