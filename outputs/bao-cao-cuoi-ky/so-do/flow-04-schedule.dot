digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Tổ chức lịch và điểm danh"; labelloc=t;
subgraph cluster_0 { label="Quản lý"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#f4f8fc";
a [label="Chọn bộ môn, HLV, phòng,\nkhung giờ và lịch tuần", shape=box];
c [label="Đổi lịch/phòng/HLV\nhoặc bảo trì/huỷ", shape=box];
}
subgraph cluster_1 { label="Hệ thống"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#eaf4f3";
b [label="Tài nguyên hợp lệ; không\ntrùng phòng/HLV; tạo buổi", shape=box];
d [label="Giữ lịch sử; audit + outbox\ncho đúng người nhận", shape=box];
f [label="Đúng phạm vi và\nthời điểm được sửa?", shape=diamond];
g [label="Lưu PRESENT / ABSENT /\nEXCUSED; cập nhật lịch sử", shape=box];
h [label="Từ chối; sau buổi cần\nquyền sửa ngoại lệ", shape=box];
}
subgraph cluster_2 { label="HLV / hội viên"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#fff8ec";
e [label="Xem lịch; HLV điểm danh;\nhội viên xin nghỉ trước hạn", shape=box];
}
a -> b [label=""];
b -> e [label=""];
b -> c [label="Có thay đổi"];
c -> d [label=""];
d -> e [label=""];
e -> f [label=""];
f -> g [label="Có"];
f -> h [label="Không"];
}