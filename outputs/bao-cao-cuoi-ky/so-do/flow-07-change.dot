digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#a4bdce", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
edge [fontname="DejaVu Sans", fontsize=9, color="#527087", arrowsize=0.7];
label="Hủy khóa và hoàn tiền qua mã HT"; labelloc=t;
subgraph cluster_0 { label="Hội viên"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#f4f8fc";
a [label="Chọn Hủy khóa; đọc preview\nbuổi còn lại, phí, số hoàn", shape=box];
b [label="Nhập lý do, xác nhận REFUND", shape=box];
e [label="Xem mã trong hồ sơ;\nliên hệ admin cung cấp mã", shape=box];
}
subgraph cluster_1 { label="Hệ thống"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#eaf4f3";
c [label="Khóa giao dịch; tính lại;\nCANCELLED và nhả chỗ", shape=box];
d [label="Snapshot lịch sử; mã HT;\nthông báo đúng nhóm nhận", shape=box];
g [label="Refund DONE; báo Đã hoàn;\ngiữ hóa đơn và dữ liệu học cũ", shape=box];
}
subgraph cluster_2 { label="Admin có payment.refund"; color="#cbdbe7"; style="rounded,filled"; fillcolor="#fff8ec";
f [label="Tra mã; chuyển trả bên ngoài;\nnhập tham chiếu xác nhận", shape=box];
}
a -> b [label=""];
b -> c [label=""];
c -> d [label=""];
d -> e [label=""];
e -> f [label=""];
f -> g [label="Đã chuyển trả"];
}