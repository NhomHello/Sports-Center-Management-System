# ===== Copy file nay thanh .env (KHONG commit .env) =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MySQL chay bang docker compose o thu muc goc du an.
# user/password/db PHAI khop voi MYSQL_* trong file .env o thu muc goc.
DATABASE_URL="mysql://root:scms_root@localhost:3306/scms"

# JWT: doi thanh chuoi ngau nhien >= 32 ky tu (vi du: openssl rand -hex 32)
JWT_SECRET=change_me_change_me_change_me_change_me_32
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Cho phep ca hai dia chi local khi demo FE; production khai bao domain cu the.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Cache (giay) - permission cua role & system setting
PERMISSION_CACHE_TTL_SECONDS=30
SETTING_CACHE_TTL_SECONDS=60

# Email SMTP (nodemailer). De trong MAIL_HOST => khong gui that, chi in noi dung mail ra log.
# Dev: Mailtrap Sandbox (sandbox.smtp.mailtrap.io, port 2525). Demo: Brevo (smtp-relay.brevo.com:587)
# hoac Gmail (smtp.gmail.com:587, dung App Password).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sports Center <no-reply@scms.local>"
# URL FE de tao link xac minh email
APP_BASE_URL=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Tai khoan quan tri dau tien - CHI dung khi chay seed
SEED_ADMIN_EMAIL=admin@scms.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Center Manager

# Du lieu mau cho dev (le tan, coach, member...) - xem prisma/seed/mock/users.mock.js
SEED_MOCK_DATA=true
SEED_MOCK_PASSWORD=Member@123

# SePay Test mode: https://my.sepay.vn (bat Test mode) -> Tich hop Webhook, chon xac thuc Api_Key.
# SEPAY_WEBHOOK_API_KEY phai TRUNG voi API key khai bao khi tao webhook. Webhook URL: <ngrok>/api/v1/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
# Token API SePay cho nut "Dong bo tu SePay" o hang cho doi soat (bo trong = tat tinh nang nay)
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
