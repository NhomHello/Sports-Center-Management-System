// ============================================================
// Prisma schema - Sports Center Management System (MySQL)
// Quy uoc:
//  - Model: PascalCase so it (User), bang: snake_case so nhieu (@@map("users"))
//  - Cot: camelCase trong code, snake_case trong DB (@map)
//  - Moi bang co createdAt / updatedAt
//  - Model nghiep vu (MembershipPlan, Class, Invoice...) team them vao sau,
//    moi model mot khoi rieng + comment dau khoi.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------- ENUMS ----------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InvoiceChannel {
  ONLINE
  COUNTER
}

enum PaymentProvider {
  COUNTER
  MANUAL
  SEPAY
  SIMULATOR
}

enum NotificationKind {
  MEMBERSHIP_EXPIRY_REMINDER
  CLASS_CHANGED
  CLASS_CANCELLED
  TRAINING_PLAN_PUBLISHED
  TRAINING_RESULT_CREATED
}

// ---------------- AUTH & RBAC (dynamic) ----------------

/// Tai khoan dang nhap. Moi user co DUNG MOT role; role quyet dinh permission.
model User {
  id            Int            @id @default(autoincrement())
  email         String?        @unique @db.VarChar(191)
  phone         String?        @unique @db.VarChar(20)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  tokenVersion  Int            @default(0) @map("token_version")
  fullName      String         @map("full_name") @db.VarChar(100)
  status        UserStatus     @default(ACTIVE)
  roleId        Int            @map("role_id")
  role          Role           @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  memberships   Membership[]
  invoices      Invoice[]
  notifications Notification[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

/// Vai tro: tap hop permission. Tao/sua/xoa hoan toan qua UI (tru isSystem khong duoc xoa).
model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  /// Role seed san, khong cho xoa (van cho sua quyen)
  isSystem    Boolean          @default(false) @map("is_system")
  /// Role gan cho tai khoan tu dang ky. Chi mot role duoc isDefault = true
  isDefault   Boolean          @default(false) @map("is_default")
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

/// Permission = mot hanh dong he thong cho phep. Seed tu core/shared/src/permissions.js
model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  moduleLabel String           @map("module_label") @db.VarChar(100)
  action      String           @db.VarChar(50)
  label       String           @db.VarChar(255)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------- SYSTEM SETTINGS (khong hardcode so nghiep vu) ----------------

/// Cau hinh he thong. Seed tu core/shared/src/settings.js, Center Manager sua qua UI.
model SystemSetting {
  key         String      @id @db.VarChar(100)
  value       String      @db.Text
  type        SettingType
  label       String      @db.VarChar(255)
  description String?     @db.VarChar(500)
  group       String      @db.VarChar(50)
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ---------------- AUDIT LOG ----------------

/// Nhat ky thao tac quan trong (Center Manager xem).
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(50)
  meta      Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------- NGHIEP VU (team them dan theo flow) ----------------
// Flow 1: MembershipPlan, Membership
// Flow 2: Subject, Room, GymClass (tranh dat ten "Class" trung tu khoa JS), ClassSession, Enrollment
// Flow 3: Invoice, Payment, PaymentWebhookLog

/// Danh mục gói dùng bởi hóa đơn tại quầy; không xóa gói đã được tham chiếu.
model MembershipPlan {
  id           Int          @id @default(autoincrement())
  code         String       @unique @db.VarChar(50)
  name         String       @db.VarChar(100)
  durationDays Int          @map("duration_days")
  price        Int
  benefits     Json?
  isActive     Boolean      @default(true) @map("is_active")
  memberships  Membership[]
  invoices     Invoice[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("membership_plans")
}

/// BR-1.2: activeUserId duy nhất bảo vệ một membership ACTIVE cho mỗi hội viên.
model Membership {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  activeUserId  Int?             @unique @map("active_user_id")
  planId        Int              @map("plan_id")
  startDate     DateTime         @map("start_date")
  endDate       DateTime         @map("end_date")
  status        MembershipStatus @default(ACTIVE)
  user          User             @relation(fields: [userId], references: [id])
  plan          MembershipPlan   @relation(fields: [planId], references: [id])
  invoices      Invoice[]
  notifications Notification[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([userId, status, endDate])
  @@index([planId])
  @@map("memberships")
}

/// Giá và thời hạn được chụp lúc tạo; thay đổi danh mục không sửa giao dịch cũ.
model Invoice {
  id           Int            @id @default(autoincrement())
  code         String         @unique @db.VarChar(50)
  userId       Int            @map("user_id")
  planId       Int            @map("plan_id")
  planName     String?        @map("plan_name") @db.VarChar(100)
  durationDays Int?           @map("duration_days")
  membershipId Int?           @map("membership_id")
  amount       Int
  status       InvoiceStatus  @default(PENDING)
  channel      InvoiceChannel @default(COUNTER)
  expiresAt    DateTime       @map("expires_at")
  paidAt       DateTime?      @map("paid_at")
  user         User           @relation(fields: [userId], references: [id])
  plan         MembershipPlan @relation(fields: [planId], references: [id])
  membership   Membership?    @relation(fields: [membershipId], references: [id])
  payments     Payment[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([userId, planId, status])
  @@index([status, expiresAt])
  @@map("invoices")
}

/// BR-PAY-14: khoản thực thu gắn hóa đơn và người thu, không nhận giá từ client.
model Payment {
  id              Int             @id @default(autoincrement())
  invoiceId       Int             @map("invoice_id")
  provider        PaymentProvider
  requestedAmount Int             @map("requested_amount")
  receivedAmount  Int             @map("received_amount")
  reference       String?         @db.VarChar(100)
  paidAt          DateTime        @map("paid_at")
  actorId         Int?            @map("actor_id")
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([invoiceId, paidAt])
  @@map("payments")
}

/// Lịch sử thông báo; dedupeKey chống gửi lặp và readAt được giữ khi đọc lại.
model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  membershipId Int?             @map("membership_id")
  kind         NotificationKind
  title        String           @db.VarChar(150)
  message      String           @db.VarChar(500)
  readAt       DateTime?        @map("read_at")
  user         User             @relation(fields: [userId], references: [id])
  membership   Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  dedupeKey    String?          @unique @map("dedupe_key") @db.VarChar(191)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}
